from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, List

import numpy as np
import pandas as pd


@dataclass
class Signal:
    symbol: str
    action: str
    score: float
    confidence: float
    reason: str


class Strategy:
    def __init__(self, buy_threshold: float = 0.6, sell_threshold: float = -0.6) -> None:
        self.buy_threshold = buy_threshold
        self.sell_threshold = sell_threshold

    def _prepare(self, df: pd.DataFrame) -> pd.DataFrame:
        series = df["close"].copy()
        out = df.copy()
        out["returns"] = series.pct_change().fillna(0.0)
        out["sma_fast"] = series.rolling(10).mean()
        out["sma_slow"] = series.rolling(30).mean()
        delta = series.diff()
        gain = delta.clip(lower=0).rolling(14).mean()
        loss = (-delta.clip(upper=0)).rolling(14).mean()
        rs = gain / loss.replace(0, np.nan)
        out["rsi"] = 100 - (100 / (1 + rs))
        out["rsi"] = out["rsi"].fillna(50)
        out["macd"] = series.ewm(span=12, adjust=False).mean() - series.ewm(span=26, adjust=False).mean()
        out["signal_line"] = out["macd"].ewm(span=9, adjust=False).mean()
        out["trend_strength"] = (out["sma_fast"] / out["sma_slow"]) - 1.0
        out["mom_score"] = out["returns"].rolling(10).mean() * 100
        return out

    def generate_signal(self, symbol: str, df: pd.DataFrame) -> Signal:
        data = self._prepare(df)
        latest = data.iloc[-1]

        trend_component = 1.0 if latest["sma_fast"] > latest["sma_slow"] else -1.0
        rsi_component = (latest["rsi"] - 50) / 50
        macd_component = 1.0 if latest["macd"] > latest["signal_line"] else -1.0
        momentum_component = np.clip(latest["mom_score"] / 10.0, -1.0, 1.0)

        score = (
            0.35 * trend_component
            + 0.25 * rsi_component
            + 0.2 * (1.0 if macd_component > 0 else -1.0)
            + 0.2 * momentum_component
        )

        if score >= self.buy_threshold:
            action = "BUY"
            reason = "Bullish trend, momentum, and RSI support"
        elif score <= self.sell_threshold:
            action = "SELL"
            reason = "Bearish trend and weak momentum"
        else:
            action = "HOLD"
            reason = "Neutral conditions; wait for stronger confirmation"

        confidence = min(max(abs(score) * 1.2, 0.0), 1.0)
        return Signal(symbol=symbol, action=action, score=float(score), confidence=float(confidence), reason=reason)
